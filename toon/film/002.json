 "view": "wide", "mood": "red"}, {"a": 3570, "n": 120, "set": "void", "chars": [{"look": {"body": "#2f7d5b", "hat": "hair", "hair": "#3a2416", "legs": "#2b2b33"}, "pose": "stand", "expr": "angry"}], "view": "face", "mood": "dark"}, {"a": 3690, "n": 90, "set": "void", "chars": [], "view": "ws", "mood": "dark"}, {"a": 3780, "n": 135, "set": "bedroomday", "chars": [{"look": {"body": "#2f7d5b", "hat": "hair", "hair": "#3a2416", "legs": "#2b2b33", "tie": "#f2c230"}, "at": [-1.2, 0, -0.6], "pose": "cheer", "expr": "laugh"}], "view": "cu", "things": [{"name": "jar", "at": [-0.55, 1.0, -0.2], "text": "0.95", "fit": 0.42, "pop": false}], "mood": "sunrise", "fade": 15}, {"a": 3915, "n": 120, "set": "garage", "chars": [{"look": {"body": "#2f7d5b", "hat": "hair", "hair": "#3a2416", "legs": "#2b2b33", "tie": "#f2c230"}, "pose": "shrug", "expr": "shock"}], "view": "ms", "mood": "cold"}, {"a": 4035, "n": 120, "set": "garage", "chars": [{"look": {"body": "#2f7d5b", "hat": "hair", "hair": "#3a2416", "legs": "#2b2b33", "tie": "#f2c230"}, "pose": "stand", "expr": "smile"}], "view": "face", "mood": "warm"}, {"a": 4155, "n": 135, "set": "store", "chars": [{"look": {"body": "#2f7d5b", "hat": "hair", "hair": "#3a2416", "legs": "#2b2b33", "tie": "#f2c230"}, "pose": "count", "expr": "grin"}], "view": "ms", "things": [{"name": "cash", "at": [0.55, 1.1, 0.4], "fit": 0.35}], "mood": "warm"}, {"a": 4290, "n": 135, "set": "void", "chars": [], "view": "ws"}, {"a": 4425, "n": 120, "set": "void", "chars": [], "view": "ws"}, {"a": 4545, "n": 255, "set": "void", "chars": [], "view": "ws"}], "film": {"lines": [{"a": 4, "n": 129, "t": "Everyone wants to be rich.", "at": "mid"}, {"a": 139, "n": 114, "t": "Nobody wants to be patient.", "at": "mid"}, {"a": 259, "n": 114, "t": "Payday."}, {"a": 379, "n": 114, "t": "you deserve it", "red": true}, {"a": 499, "n": 99, "t": "one more", "red": true}, {"a": 604, "n": 114, "t": "By Friday, it was gone."}, {"a": 724, "n": 99, "t": "Every month. Same story."}, {"a": 829, "n": 114, "t": "Payday. Gone."}, {"a": 949, "n": 99, "t": "Payday. Gone again."}, {"a": 1054, "n": 114, "t": "Dinner for people he barely knew."}, {"a": 1174, "n": 99, "t": "Balance: zero. Again."}, {"a": 1279, "n": 144, "t": "He wasn't broke because he earned too little."}, {"a": 1429, "n": 144, "t": "He was broke because he kept none of it."}, {"a": 1579, "n": 144, "t": "you only live once", "red": true}, {"a": 1729, "n": 114, "t": "Then one night, he found an empty jar."}, {"a": 1849, "n": 99, "t": "One dollar. That's all."}, {"a": 2044, "n": 114, "t": "It felt stupid."}, {"a": 2164, "n": 114, "t": "just this once", "red": true}, {"a": 2284, "n": 99, "t": "He walked out with nothing."}, {"a": 2389, "n": 114, "t": "A dollar a day adds up slowly."}, {"a": 2509, "n": 129, "t": "everyone else is having fun", "red": true}, {"a": 2644, "n": 99, "t": "Let them."}, {"a": 2749, "n": 114, "t": "He asked for more hours."}, {"a": 2869, "n": 114, "t": "The jar got heavy."}, {"a": 2989, "n": 99, "t": "Some weeks he saved nothing."}, {"a": 3094, "n": 99, "t": "He started again the next day."}, {"a": 3199, "n": 114, "t": "So he put it to work."}, {"a": 3319, "n": 114, "t": "He stopped buying things to feel rich."}, {"a": 3439, "n": 129, "t": "you'll never be rich", "red": true}, {"a": 3574, "n": 114, "t": "Maybe not. But he'd never be broke again."}, {"a": 3694, "n": 84, "t": "...", "red": true, "at": "mid"}, {"a": 3784, "n": 129, "t": "Day 365. The jar was full."}, {"a": 3919, "n": 114, "t": "Then his car broke down."}, {"a": 4039, "n": 114, "t": "For the first time, it wasn't a crisis."}, {"a": 4159, "n": 129, "t": "This time he paid cash. And kept the rest."}, {"a": 4294, "n": 129, "t": "Every fortune on this channel started small.", "at": "mid"}, {"a": 4429, "n": 114, "t": "With money somebody didn't spend.", "at": "mid"}], "cards": [{"a": 1950, "n": 90, "big": "DAY 1."}, {"a": 4545, "n": 255, "big": "SAVE.", "line": "Rich is what you keep, not what you show.", "cmd":