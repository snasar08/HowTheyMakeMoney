, {"a": 1459, "n": 144, "t": "He had just practiced quitting. Every morning."}, {"a": 1609, "n": 144, "t": "you're not built for this", "red": true}, {"a": 1759, "n": 114, "t": "Then one night, he set it again."}, {"a": 1879, "n": 99, "t": "And this time, he got up."}, {"a": 2074, "n": 114, "t": "Empty gym. Cold hands."}, {"a": 2194, "n": 99, "t": "Most shots missed."}, {"a": 2299, "n": 114, "t": "stay in bed", "red": true}, {"a": 2419, "n": 84, "t": "He went anyway."}, {"a": 2509, "n": 114, "t": "100 shots before school."}, {"a": 2629, "n": 129, "t": "nobody is watching", "red": true}, {"a": 2764, "n": 99, "t": "Nobody was."}, {"a": 2869, "n": 99, "t": "That was the point."}, {"a": 2974, "n": 99, "t": "Some mornings he hated it."}, {"a": 3079, "n": 99, "t": "He went anyway."}, {"a": 3184, "n": 114, "t": "His legs got stronger."}, {"a": 3304, "n": 114, "t": "Then his shot did."}, {"a": 3424, "n": 114, "t": "Then the kids who laughed stopped laughing."}, {"a": 3544, "n": 129, "t": "you can't", "red": true}, {"a": 3679, "n": 114, "t": "He had heard that voice every morning."}, {"a": 3799, "n": 114, "t": "So he took one more shot."}, {"a": 3919, "n": 84, "t": "...", "red": true, "at": "mid"}, {"a": 4009, "n": 129, "t": "Day 90. He was up before the alarm."}, {"a": 4144, "n": 129, "t": "This time, his name was on the list."}, {"a": 4279, "n": 129, "t": "Everyone saw the highlight."}, {"a": 4414, "n": 129, "t": "Nobody saw the 9,000 shots before it."}, {"a": 4549, "n": 129, "t": "Every pro on this channel started here.", "at": "mid"}, {"a": 4684, "n": 99, "t": "In an empty gym. Before anyone was watching.", "at": "mid"}], "cards": [{"a": 1980, "n": 90, "big": "DAY 1."}, {"a": 4785, "n": 255, "big": "PRACTICE.", "line": "Nobody claps for the shots you take alone.", "cmd": "Take one more."}], "day": [{"a": 2070, "n": 120, "t": "DAY 1"}, {"a": 2190, "n": 105, "t": "DAY 2"}, {"a": 2295, "n": 210, "t": "DAY 9"}, {"a": 2505, "n": 120, "t": "DAY 17"}, {"a": 2625, "n": 345, "t":